{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // worker の API の型（宣言ファイル）。package.json の依存にしない（worker が、ダッシュボードに依存するため、循環する）。
    // 先に、worker の型を作る順序は、turbo.json の @uc/dashboard#typecheck が決める
    "paths": { "@uc/worker/api": ["../worker/dist/types/routes/api.d.ts"] }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
