{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // 環境は 3 つ。デプロイするときは、必ず、`--env staging` か `--env production` を付ける。
  //   最上位（ここ）: ローカルの開発用。`--env` を付け忘れても、本番にもステージングにも出ない
  //                  （名前も、D1 も、R2 も、実在しない開発用のもの。デプロイは、失敗する）
  //   env.staging:    ステージング（develop ブランチ）
  //   env.production: 本番（main ブランチ）
  // バインディング（D1・R2）と cron は、環境に引き継がれないので、環境ごとに書く。
  "name": "uc-bot-dev",

  // ダッシュボード（画面）は、同じ Worker から配信する（Cookie の SameSite=Strict と、同一オリジンを成り立たせるため）。
  // 画面は、ワークスペースのパッケージ（@uc/dashboard）。依存に書いてあるので、turbo が、先に、ビルドする
  "assets": {
    "directory": "node_modules/@uc/dashboard/dist",
    "not_found_handling": "single-page-application",
    // これらのパスは、静的ファイルより先に、worker が処理する（/dev/* は、開発の入口にだけ、ルートがある）
    "run_worker_first": ["/api/*", "/interactions", "/cron", "/dev/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uc-bot-dev",
      // ローカル開発では、この値は使われない（ローカルの DB が、使われる）
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "node_modules/@uc/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "SCREENSHOTS", "bucket_name": "uc-bot-dev-screenshots" }],

  // Cloudflare の Cron Trigger は、使わない（cron は、apps/cron の Apps Script が、POST /cron で起こす）。
  // 空の配列は、「登録済みの Cron Trigger を、デプロイで消す」という意味（省略すると、登録済みのものが、残る）
  "triggers": { "crons": [] },

  "env": {
    "staging": {
      "name": "uc-bot-stg",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "uc-bot-staging",
          // `wrangler d1 create uc-bot-staging` で出た ID（秘密ではない）
          "database_id": "cefbac3d-b216-43ca-8b14-13181f7b0564",
          "migrations_dir": "node_modules/@uc/db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "SCREENSHOTS", "bucket_name": "uc-bot-staging-screenshots" }],
      "triggers": { "crons": [] }
    },
    "production": {
      "name": "uc-bot",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "uc-bot",
          // `wrangler d1 create uc-bot` で出た ID（秘密ではない）
          "database_id": "54907620-232e-4648-90c3-9184a53721f1",
          "migrations_dir": "node_modules/@uc/db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "SCREENSHOTS", "bucket_name": "uc-bot-screenshots" }],
      "triggers": { "crons": [] }
    }
  }
}
