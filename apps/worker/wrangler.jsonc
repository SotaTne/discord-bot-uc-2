{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uc-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // ダッシュボード（画面）は、同じ Worker から配信する（Cookie の SameSite=Strict と、同一オリジンを成り立たせるため）。
  // 画面は、apps/dashboard の Vite が、worker といっしょにビルドする。配信するファイルの場所（directory）は、Vite のプラグインが決めるので、書かない。
  "assets": {
    "not_found_handling": "single-page-application",
    // これらのパスは、静的ファイルより先に、worker が処理する（/dev/* は、開発のビルドにだけ、ルートがある）
    "run_worker_first": ["/api/*", "/interactions", "/dev/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uc-bot",
      // ローカル開発では使われない。デプロイ前に `wrangler d1 create uc-bot` の値に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "uc-bot-screenshots"
    }
  ],

  // 毎分起動する。募集開始の投稿と、試合の K 分前の締切（マッチングの確定）を、時刻が来ていれば行う
  "triggers": { "crons": ["* * * * *"] }
}
