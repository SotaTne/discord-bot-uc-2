# apps/cron/.env.local にコピーして、値を書く（.env.local は git に入れない）。pnpm push / start / stop / health が読む。
# 値は、ふつう、コマンドが書く（手で作らなくてよい）

# Worker の CRON_SECRET と同じ値（Apps Script のスクリプトプロパティの CRON_SECRET とも同じ）。ルートの `pnpm update-cron-secret` が書く
CRON_SECRET=
# ウェブアプリのデプロイの ID（AKfycb…。秘密ではない）。初回の `pnpm push` が書く
GAS_DEPLOYMENT_ID=
