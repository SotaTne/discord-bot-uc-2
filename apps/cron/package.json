{
  "name": "@uc/cron-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "create": "clasp create-script --type standalone --title \"UC cron\" --rootDir dist",
    "push": "pnpm build && clasp push",
    "logs": "clasp tail-logs",
    "delete": "clasp delete-script",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@uc/cron": "workspace:*"
  },
  "devDependencies": {
    "@google/clasp": "catalog:",
    "@types/google-apps-script": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
