{
  "name": "discord-bot-uc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26.11.1 <27",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm dev:setup && turbo run dev",
    "dev:setup": "pnpm --filter @uc/mock run setup-dev && pnpm --filter @uc/worker run db:migrate && pnpm --filter @uc/worker run db:seed",
    "tunnel": "pnpm --filter @uc/worker tunnel",
    "typecheck": "turbo run typecheck",
    "test": "vitest run && turbo run test",
    "check": "pnpm typecheck && pnpm test",
    "register-commands": "pnpm --filter @uc/discord run register-commands",
    "update-cron-secret": "tsx scripts/update-cron-secret.ts"
  },
  "devDependencies": {
    "@actions/core": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
