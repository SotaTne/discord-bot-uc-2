{
  "name": "discord-bot-uc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.28.5"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm dev:setup && turbo run dev",
    "dev:setup": "pnpm --filter @uc/mock run setup-dev && pnpm --filter @uc/worker run db:migrate && pnpm --filter @uc/worker run db:seed",
    "tunnel": "pnpm --filter @uc/worker tunnel",
    "typecheck": "turbo run typecheck",
    "test": "vitest run && turbo run test",
    "check": "pnpm typecheck && pnpm test",
    "register-commands": "pnpm --filter @uc/discord run register-commands"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
